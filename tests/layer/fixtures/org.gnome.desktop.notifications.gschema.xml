<!-- gsettings-desktop-schemas' key that Do Not Disturb turns off. -->
<schemalist>
  <schema id="org.gnome.desktop.notifications" path="/org/gnome/desktop/notifications/">
    <key name="show-banners" type="b">
      <default>true</default>
    </key>
  </schema>
</schemalist>
