# Anchored edits to Fedora's gnome-builder.spec; format and placeholders:
# packaging/README.md. apex-lane adds the PatchNNNN lines itself.

# %{autorelease} with braces sorts the suffix above Fedora's build (see gnome-shell's).
replace ^Release:[[:space:]]+%autorelease$
	Release:	%{autorelease}@APEX_RELEASE@
end

after ^Source0:[[:space:]]
	Source1:	@SOURCE1@
end

after ^%autosetup[[:space:]]
	# Apex: src/plugins/apex/ (Source1, desktop/gnome-builder/ in apex-gnome); -k never clobbers upstream.
	tar -xkf %{SOURCE1}
end

# Apex's own gettext domain (desktop/gnome-builder/src/plugins/apex/po), in the main package's list.
after ^%find_lang[[:space:]]+%\{name\}$
	%find_lang apex-builder
	cat apex-builder.lang >> %{name}.lang
end
