From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Thuong Vo <66083331+SekiroKenjii@users.noreply.github.com>
Date: Sun, 15 Nov 2026 11:17:17 +0000
Subject: [PATCH] diagnostic-tool: look up the program off the main thread

A file's first diagnostics pass looked up its program (flake8, eslint...)
on the main thread: ide_pipeline_contains_program_in_path() and then the
host runtime's lookup. Each spawns `which` and waits for it, and in a
podman runtime that is a `podman exec`, 134-177 ms each. Opening a Python
file with a toolbox as the runtime froze the editor for 0.3-0.8 s while
they ran.

diagnose_async() now collects the lookups prepare_run_context() makes and
runs them on a worker thread first, filling the runtimes' path caches
(both are IdePathCache, which locks, and the podman runtime starts its
container under a mutex). prepare_run_context() then runs on the main
thread as before and finds every answer cached. The SDK extensions of a
Flatpak configuration are left to the main thread, as before.
---
 src/libide/foundry/ide-diagnostic-tool.c | 234 ++++++++++++++++++++---
 1 file changed, 203 insertions(+), 31 deletions(-)

diff --git a/src/libide/foundry/ide-diagnostic-tool.c b/src/libide/foundry/ide-diagnostic-tool.c
index f373324..28a76dd 100644
--- a/src/libide/foundry/ide-diagnostic-tool.c
+++ b/src/libide/foundry/ide-diagnostic-tool.c
@@ -25,6 +25,7 @@
 #include <libide-threading.h>
 
 #include "ide-build-manager.h"
+#include "ide-config.h"
 #include "ide-diagnostic-tool.h"
 #include "ide-pipeline.h"
 #include "ide-run-context.h"
@@ -45,8 +46,16 @@ typedef struct
 {
   GBytes *stdin_bytes;
   GFile  *file;
+  GBytes *contents;
+  char   *lang_id;
 } DiagnoseState;
 
+typedef struct
+{
+  GPtrArray *runtimes;
+  GPtrArray *programs;
+} Lookups;
+
 static void diagnostic_provider_iface_init (IdeDiagnosticProviderInterface *iface);
 
 G_DEFINE_ABSTRACT_TYPE_WITH_CODE (IdeDiagnosticTool, ide_diagnostic_tool, IDE_TYPE_OBJECT,
@@ -74,6 +83,8 @@ diagnose_state_free (DiagnoseState *state)
 
   g_clear_pointer (&state->stdin_bytes, g_bytes_unref);
   g_clear_object (&state->file);
+  g_clear_pointer (&state->contents, g_bytes_unref);
+  g_clear_pointer (&state->lang_id, g_free);
   g_slice_free (DiagnoseState, state);
 
   IDE_EXIT;
@@ -433,6 +444,189 @@ ide_diagnostic_tool_communicate_cb (GObject      *object,
   IDE_EXIT;
 }
 
+static void
+lookups_free (Lookups *lookups)
+{
+  g_clear_pointer (&lookups->runtimes, g_ptr_array_unref);
+  g_clear_pointer (&lookups->programs, g_ptr_array_unref);
+  g_free (lookups);
+}
+
+static void
+lookups_add (Lookups    *lookups,
+             IdeRuntime *runtime,
+             const char *program)
+{
+  g_ptr_array_add (lookups->runtimes, g_object_ref (runtime));
+  g_ptr_array_add (lookups->programs, g_strdup (program));
+}
+
+static void
+lookups_add_in_path (Lookups    *lookups,
+                     IdeRuntime *runtime,
+                     const char *program,
+                     const char *path)
+{
+  g_auto(GStrv) dirs = NULL;
+
+  if (path == NULL)
+    return;
+
+  dirs = g_strsplit (path, ":", 0);
+
+  for (guint i = 0; dirs[i]; i++)
+    {
+      g_autofree char *filename = g_build_filename (dirs[i], program, NULL);
+      lookups_add (lookups, runtime, filename);
+    }
+}
+
+/* The programs prepare_run_context() looks up, so the runtimes' path caches
+ * answer them there. A lookup spawns `which`, in a container a `podman exec`,
+ * and blocks until it exits.
+ */
+static Lookups *
+ide_diagnostic_tool_collect_lookups (IdeDiagnosticTool *self)
+{
+  IdeDiagnosticToolPrivate *priv = ide_diagnostic_tool_get_instance_private (self);
+  g_autoptr(IdeContext) context = NULL;
+  g_autofree char *program_path = NULL;
+  IdePipeline *pipeline;
+  IdeRuntime *runtime;
+  IdeRuntime *host;
+  Lookups *lookups;
+
+  g_assert (IDE_IS_MAIN_THREAD ());
+
+  if (!(context = ide_object_ref_context (IDE_OBJECT (self))) ||
+      !ide_context_has_project (context))
+    return NULL;
+
+  pipeline = ide_build_manager_get_pipeline (ide_build_manager_from_context (context));
+  host = ide_runtime_manager_get_runtime (ide_runtime_manager_from_context (context), "host");
+
+  lookups = g_new0 (Lookups, 1);
+  lookups->runtimes = g_ptr_array_new_with_free_func (g_object_unref);
+  lookups->programs = g_ptr_array_new_with_free_func (g_free);
+
+  if (pipeline != NULL && priv->local_program_path != NULL)
+    {
+      g_autofree char *local = g_build_filename (ide_pipeline_get_srcdir (pipeline), priv->local_program_path, NULL);
+      if (g_file_test (local, G_FILE_TEST_IS_EXECUTABLE))
+        program_path = g_steal_pointer (&local);
+    }
+
+  if (pipeline != NULL && (runtime = ide_pipeline_get_runtime (pipeline)))
+    {
+      IdeConfig *config = ide_pipeline_get_config (pipeline);
+      const char *programs[] = { program_path, priv->program_name };
+
+      for (guint i = 0; i < G_N_ELEMENTS (programs); i++)
+        {
+          if (programs[i] == NULL)
+            continue;
+
+          lookups_add (lookups, runtime, programs[i]);
+
+          if (config != NULL)
+            {
+              lookups_add_in_path (lookups, runtime, programs[i], ide_config_get_prepend_path (config));
+              lookups_add_in_path (lookups, runtime, programs[i], ide_config_get_append_path (config));
+            }
+        }
+    }
+
+  if (host != NULL && program_path == NULL)
+    lookups_add (lookups, host, priv->program_name);
+
+  return lookups;
+}
+
+static void
+ide_diagnostic_tool_lookup_worker (IdeTask      *task,
+                                   gpointer      source_object,
+                                   gpointer      task_data,
+                                   GCancellable *cancellable)
+{
+  Lookups *lookups = task_data;
+
+  /* No cancellable: a cancelled lookup would be cached as a miss. */
+  for (guint i = 0; i < lookups->runtimes->len; i++)
+    ide_runtime_contains_program_in_path (g_ptr_array_index (lookups->runtimes, i),
+                                          g_ptr_array_index (lookups->programs, i),
+                                          NULL);
+
+  ide_task_return_boolean (task, TRUE);
+}
+
+static void
+ide_diagnostic_tool_spawn (IdeDiagnosticTool *self,
+                           IdeTask           *task)
+{
+  IdeDiagnosticToolPrivate *priv = ide_diagnostic_tool_get_instance_private (self);
+  DiagnoseState *state = ide_task_get_task_data (task);
+  GCancellable *cancellable = ide_task_get_cancellable (task);
+  g_autoptr(IdeSubprocessLauncher) launcher = NULL;
+  g_autoptr(IdeRunContext) run_context = NULL;
+  g_autoptr(IdeSubprocess) subprocess = NULL;
+  g_autoptr(GError) error = NULL;
+  const char *stdin_data;
+
+  IDE_ENTRY;
+
+  if (ide_task_return_error_if_cancelled (task))
+    IDE_EXIT;
+
+  run_context = ide_run_context_new ();
+
+  if (!IDE_DIAGNOSTIC_TOOL_GET_CLASS (self)->prepare_run_context (self, run_context, state->file, state->contents, state->lang_id, &error) ||
+      !(launcher = ide_run_context_end (run_context, &error)))
+    {
+      g_assert (error != NULL);
+
+      ide_task_return_error (task, g_steal_pointer (&error));
+      IDE_EXIT;
+    }
+
+  ide_subprocess_launcher_set_flags (launcher, priv->flags);
+
+  if (!(subprocess = ide_subprocess_launcher_spawn (launcher, cancellable, &error)))
+    {
+      g_assert (error != NULL);
+
+      ide_task_return_error (task, g_steal_pointer (&error));
+      IDE_EXIT;
+    }
+
+  if (state->stdin_bytes != NULL)
+    stdin_data = (char *)g_bytes_get_data (state->stdin_bytes, NULL);
+  else
+    stdin_data = NULL;
+
+  ide_subprocess_communicate_utf8_async (subprocess,
+                                         stdin_data,
+                                         cancellable,
+                                         ide_diagnostic_tool_communicate_cb,
+                                         g_object_ref (task));
+
+  IDE_EXIT;
+}
+
+static void
+ide_diagnostic_tool_lookup_cb (GObject      *object,
+                               GAsyncResult *result,
+                               gpointer      user_data)
+{
+  g_autoptr(IdeTask) task = user_data;
+
+  g_assert (IDE_IS_DIAGNOSTIC_TOOL (object));
+  g_assert (IDE_IS_TASK (result));
+  g_assert (IDE_IS_TASK (task));
+
+  ide_task_propagate_boolean (IDE_TASK (result), NULL);
+  ide_diagnostic_tool_spawn (IDE_DIAGNOSTIC_TOOL (object), task);
+}
+
 static void
 ide_diagnostic_tool_diagnose_async (IdeDiagnosticProvider *provider,
                                     GFile                 *file,
@@ -444,13 +638,9 @@ ide_diagnostic_tool_diagnose_async (IdeDiagnosticProvider *provider,
 {
   IdeDiagnosticTool *self = (IdeDiagnosticTool *)provider;
   IdeDiagnosticToolPrivate *priv = ide_diagnostic_tool_get_instance_private (self);
-  g_autoptr(IdeSubprocessLauncher) launcher = NULL;
-  g_autoptr(IdeRunContext) run_context = NULL;
-  g_autoptr(IdeSubprocess) subprocess = NULL;
   g_autoptr(IdeTask) task = NULL;
-  g_autoptr(GError) error = NULL;
   DiagnoseState *state;
-  const char *stdin_data;
+  Lookups *lookups;
 
   IDE_ENTRY;
 
@@ -475,6 +665,8 @@ ide_diagnostic_tool_diagnose_async (IdeDiagnosticProvider *provider,
 
   state = g_slice_new0 (DiagnoseState);
   state->file = file ? g_object_ref (file) : NULL;
+  state->contents = contents ? g_bytes_ref (contents) : NULL;
+  state->lang_id = g_strdup (lang_id);
   state->stdin_bytes = IDE_DIAGNOSTIC_TOOL_GET_CLASS (self)->get_stdin_bytes (self, file, contents, lang_id);
   ide_task_set_task_data (task, state, diagnose_state_free);
 
@@ -487,37 +679,17 @@ ide_diagnostic_tool_diagnose_async (IdeDiagnosticProvider *provider,
       IDE_EXIT;
     }
 
-  run_context = ide_run_context_new ();
-
-  if (!IDE_DIAGNOSTIC_TOOL_GET_CLASS (self)->prepare_run_context (self, run_context, file, contents, lang_id, &error) ||
-      !(launcher = ide_run_context_end (run_context, &error)))
+  if ((lookups = ide_diagnostic_tool_collect_lookups (self)))
     {
-      g_assert (error != NULL);
+      g_autoptr(IdeTask) lookup = ide_task_new (self, NULL, ide_diagnostic_tool_lookup_cb, g_steal_pointer (&task));
 
-      ide_task_return_error (task, g_steal_pointer (&error));
+      ide_task_set_source_tag (lookup, ide_diagnostic_tool_collect_lookups);
+      ide_task_set_task_data (lookup, lookups, lookups_free);
+      ide_task_run_in_thread (lookup, ide_diagnostic_tool_lookup_worker);
       IDE_EXIT;
     }
 
-  ide_subprocess_launcher_set_flags (launcher, priv->flags);
-
-  if (!(subprocess = ide_subprocess_launcher_spawn (launcher, cancellable, &error)))
-    {
-      g_assert (error != NULL);
-
-      ide_task_return_error (task, g_steal_pointer (&error));
-      IDE_EXIT;
-    }
-
-  if (state->stdin_bytes != NULL)
-    stdin_data = (char *)g_bytes_get_data (state->stdin_bytes, NULL);
-  else
-    stdin_data = NULL;
-
-  ide_subprocess_communicate_utf8_async (subprocess,
-                                         stdin_data,
-                                         cancellable,
-                                         ide_diagnostic_tool_communicate_cb,
-                                         g_steal_pointer (&task));
+  ide_diagnostic_tool_spawn (self, task);
 
   IDE_EXIT;
 }
