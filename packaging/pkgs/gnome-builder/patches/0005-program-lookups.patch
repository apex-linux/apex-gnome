+static void
+ide_diagnostic_tool_spawn (IdeDiagnosticTool *self,
+                           IdeTask           *task)
+{
+  IdeDiagnosticToolPrivate *priv = ide_diagnostic_tool_get_instance_private (self);
+  DiagnoseState *state = ide_task_get_task_data (task);
+  GCancellable *cancellable = ide_task_get_cancellable (task);
+  g_autoptr(IdeSubprocessLauncher) launcher = NULL;
+  g_autoptr(IdeRunContext) run_context = NULL;
+  g_autoptr(IdeSubprocess) subprocess = NULL;
+  g_autoptr(GError) error = NULL;
+  const char *stdin_data;
+
+  IDE_ENTRY;
+
+  if (ide_task_return_error_if_cancelled (task))
+    IDE_EXIT;
+
+  run_context = ide_run_context_new ();
+
+  if (!IDE_DIAGNOSTIC_TOOL_GET_CLASS (self)->prepare_run_context (self, run_context, state->file, state->contents, state->lang_id, &error) ||
+      !(launcher = ide_run_context_end (run_context, &error)))
+    {
+      g_assert (error != NULL);
+
+      ide_task_return_error (task, g_steal_pointer (&error));
+      IDE_EXIT;
+    }
+
+  ide_subprocess_launcher_set_flags (launcher, priv->flags);
+
+  if (!(subprocess = ide_subprocess_launcher_spawn (launcher, cancellable, &error)))
+    {
+      g_assert (error != NULL);
+
+      ide_task_return_error (task, g_steal_pointer (&error));
+      IDE_EXIT;
+    }
+
+  if (state->stdin_bytes != NULL)
+    stdin_data = (char *)g_bytes_get_data (state->stdin_bytes, NULL);
+  else
+    stdin_data = NULL;
+
+  ide_subprocess_communicate_utf8_async (subprocess,
+                                         stdin_data,
+                                         cancellable,
+                                         ide_diagnostic_tool_communicate_cb,
+                                         g_object_ref (task));
+
+  IDE_EXIT;
+}
+
+static void
+ide_diagnostic_tool_find_programs_cb (GObject      *object,
+                                      GAsyncResult *result,
+                                      gpointer      user_data)
+{
+  g_autoptr(IdeTask) task = user_data;
+
+  g_assert (IDE_IS_PIPELINE (object));
+  g_assert (IDE_IS_TASK (task));
+
+  _ide_pipeline_find_programs_finish (IDE_PIPELINE (object), result, NULL);
+  ide_diagnostic_tool_spawn (ide_task_get_source_object (task), task);
+}
+
+/* The project's pipeline, if there is one, and the local program prepare_run_context() would use. */
+static IdePipeline *
+ide_diagnostic_tool_get_pipeline (IdeDiagnosticTool  *self,
+                                  char              **local_program)
+{
+  IdeDiagnosticToolPrivate *priv = ide_diagnostic_tool_get_instance_private (self);
+  g_autoptr(IdeContext) context = NULL;
+  IdePipeline *pipeline;
+
+  if (!(context = ide_object_ref_context (IDE_OBJECT (self))) ||
+      !ide_context_has_project (context) ||
+      !(pipeline = ide_build_manager_get_pipeline (ide_build_manager_from_context (context))))
+    return NULL;
+
+  if (priv->local_program_path != NULL)
+    {
+      g_autofree char *local = g_build_filename (ide_pipeline_get_srcdir (pipeline), priv->local_program_path, NULL);
+      if (g_file_test (local, G_FILE_TEST_IS_EXECUTABLE))
+        *local_program = g_steal_pointer (&local);
+    }
+
+  return pipeline;
+}
