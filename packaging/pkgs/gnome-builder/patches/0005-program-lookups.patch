diff --git a/src/libide/foundry/ide-path-cache.c b/src/libide/foundry/ide-path-cache.c
index e430b6e..161c31c 100644
--- a/src/libide/foundry/ide-path-cache.c
+++ b/src/libide/foundry/ide-path-cache.c
@@ -183,3 +183,19 @@ ide_path_cache_insert (IdePathCache *self,
   g_hash_table_insert (self->cache, key, value);
   g_mutex_unlock (&self->mutex);
 }
+
+/**
+ * ide_path_cache_clear:
+ * @self: a #IdePathCache
+ *
+ * Removes every entry, positive and negative, so that the next lookups ask again.
+ */
+void
+ide_path_cache_clear (IdePathCache *self)
+{
+  g_return_if_fail (IDE_IS_PATH_CACHE (self));
+
+  g_mutex_lock (&self->mutex);
+  g_hash_table_remove_all (self->cache);
+  g_mutex_unlock (&self->mutex);
+}
