+typedef struct
+{
+  GPtrArray *runtimes;
+  GPtrArray *programs;
+} FindPrograms;
+
+static void
+find_programs_free (FindPrograms *find)
+{
+  g_clear_pointer (&find->runtimes, g_ptr_array_unref);
+  g_clear_pointer (&find->programs, g_ptr_array_unref);
+  g_free (find);
+}
+
+static void
+find_programs_add (FindPrograms *find,
+                   IdeRuntime   *runtime,
+                   const char   *program,
+                   const char   *path)
+{
+  g_auto(GStrv) dirs = NULL;
+
+  if (path == NULL)
+    {
+      g_ptr_array_add (find->runtimes, g_object_ref (runtime));
+      g_ptr_array_add (find->programs, g_strdup (program));
+      return;
+    }
+
+  dirs = g_strsplit (path, ":", 0);
+
+  for (guint i = 0; dirs[i]; i++)
+    {
+      g_autofree char *filename = g_build_filename (dirs[i], program, NULL);
+      find_programs_add (find, runtime, filename, NULL);
+    }
+}
+
+static void
+find_programs_worker (IdeTask      *task,
+                      gpointer      source_object,
+                      gpointer      task_data,
+                      GCancellable *cancellable)
+{
+  FindPrograms *find = task_data;
+
+  /* No cancellable: a cancelled lookup would be cached as a miss. */
+  for (guint i = 0; i < find->runtimes->len; i++)
+    ide_runtime_contains_program_in_path (g_ptr_array_index (find->runtimes, i),
+                                          g_ptr_array_index (find->programs, i),
+                                          NULL);
+
+  ide_task_return_boolean (task, TRUE);
+}
+
+/*
+ * _ide_pipeline_find_programs_async:
+ *
+ * Looks up @programs on a worker thread, as ide_pipeline_contains_program_in_path()
+ * and the "host" runtime's lookup do, so that those calls then answer from the
+ * runtimes' path caches instead of spawning `which` (a `podman exec` in a container)
+ * on the main thread. The SDK extensions of a Flatpak configuration are left out.
+ */
+void
+_ide_pipeline_find_programs_async (IdePipeline         *self,
+                                   const char * const  *programs,
+                                   GCancellable        *cancellable,
+                                   GAsyncReadyCallback  callback,
+                                   gpointer             user_data)
+{
+  g_autoptr(IdeContext) context = NULL;
+  g_autoptr(IdeTask) task = NULL;
+  const char *prepend_path = NULL;
+  const char *append_path = NULL;
+  IdeRuntime *host = NULL;
+  FindPrograms *find;
+
+  g_return_if_fail (IDE_IS_MAIN_THREAD ());
+  g_return_if_fail (IDE_IS_PIPELINE (self));
+  g_return_if_fail (programs != NULL);
+
+  task = ide_task_new (self, cancellable, callback, user_data);
+  ide_task_set_source_tag (task, _ide_pipeline_find_programs_async);
+
+  if ((context = ide_object_ref_context (IDE_OBJECT (self))))
+    host = ide_runtime_manager_get_runtime (ide_runtime_manager_from_context (context), "host");
+
+  if (self->config != NULL)
+    {
+      prepend_path = ide_config_get_prepend_path (self->config);
+      append_path = ide_config_get_append_path (self->config);
+    }
+
+  find = g_new0 (FindPrograms, 1);
+  find->runtimes = g_ptr_array_new_with_free_func (g_object_unref);
+  find->programs = g_ptr_array_new_with_free_func (g_free);
+
+  for (guint i = 0; programs[i]; i++)
+    {
+      if (self->runtime != NULL)
+        {
+          find_programs_add (find, self->runtime, programs[i], NULL);
+          find_programs_add (find, self->runtime, programs[i], prepend_path);
+          find_programs_add (find, self->runtime, programs[i], append_path);
+        }
+
+      if (host != NULL)
+        find_programs_add (find, host, programs[i], NULL);
+    }
+
+  ide_task_set_task_data (task, find, find_programs_free);
+  ide_task_run_in_thread (task, find_programs_worker);
+}
+
+gboolean
+_ide_pipeline_find_programs_finish (IdePipeline   *self,
+                                    GAsyncResult  *result,
+                                    GError       **error)
+{
+  g_return_val_if_fail (IDE_IS_PIPELINE (self), FALSE);
+  g_return_val_if_fail (IDE_IS_TASK (result), FALSE);
+
+  return ide_task_propagate_boolean (IDE_TASK (result), error);
+}
+
 /**
  * ide_pipeline_contains_program_in_path:
  * @self: a #IdePipeline
