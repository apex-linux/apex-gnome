@@ -1357,6 +1358,31 @@ ide_pipeline_load (IdePipeline *self)
   IDE_EXIT;
 }
 
+static void
+ide_pipeline_load_find_programs_cb (GObject      *object,
+                                    GAsyncResult *result,
+                                    gpointer      user_data)
+{
+  IdePipeline *self = (IdePipeline *)object;
+  g_autoptr(IdeDeviceInfo) info = user_data;
+
+  IDE_ENTRY;
+
+  g_assert (IDE_IS_PIPELINE (self));
+  g_assert (IDE_IS_DEVICE_INFO (info));
+
+  _ide_pipeline_find_programs_finish (self, result, NULL);
+
+  if (g_cancellable_is_cancelled (self->cancellable))
+    IDE_EXIT;
+
+  _ide_pipeline_check_toolchain (self, info);
+
+  ide_pipeline_load (self);
+
+  IDE_EXIT;
+}
+
 static void
 ide_pipeline_load_get_info_cb (GObject      *object,
                                GAsyncResult *result,
@@ -1384,9 +1410,13 @@ ide_pipeline_load_get_info_cb (GObject      *object,
   if (g_cancellable_is_cancelled (self->cancellable))
     IDE_EXIT;
 
-  _ide_pipeline_check_toolchain (self, info);
-
-  ide_pipeline_load (self);
+  /* The build systems' pipeline addins look their tools up as the pipeline loads (meson
+   * and cmake ninja, cargo cargo), on the main thread: fill the caches first. */
+  _ide_pipeline_find_programs_async (self,
+                                     (const char * const []) { "ninja", "ninja-build", "cargo", NULL },
+                                     NULL,
