   IDE_EXIT;
 }
 
+static void ensure_started (IdeLspService *self,
+                            IdeContext    *context);
+
+static void
+ide_lsp_service_find_programs_cb (GObject      *object,
+                                  GAsyncResult *result,
+                                  gpointer      user_data)
+{
+  IdePipeline *pipeline = (IdePipeline *)object;
+  g_autoptr(IdeLspService) self = user_data;
+  IdeLspServicePrivate *priv = ide_lsp_service_get_instance_private (self);
+  IdeContext *context;
+
+  g_assert (IDE_IS_PIPELINE (pipeline));
+  g_assert (IDE_IS_LSP_SERVICE (self));
+
+  _ide_pipeline_find_programs_finish (pipeline, result, NULL);
+  priv->finding = FALSE;
+  g_set_weak_pointer (&priv->found_in, pipeline);
+
+  if (!ide_object_in_destruction (IDE_OBJECT (self)) &&
+      (context = ide_object_get_context (IDE_OBJECT (self))))
+    ensure_started (self, context);
+}
+
 static void
 ensure_started (IdeLspService *self,
                 IdeContext    *context)
@@ -603,6 +633,22 @@ ensure_started (IdeLspService *self,
   if (!ide_pipeline_is_ready (pipeline))
     IDE_EXIT;
 
+  /* ide_lsp_service_create_launcher() looks the program up on the main thread:
+   * fill the runtimes' path caches first, on a worker thread, once per pipeline. */
+  if (priv->program != NULL && priv->found_in != pipeline)
+    {
+      if (!priv->finding)
+        {
+          const char *programs[] = { priv->program, NULL };
+
+          priv->finding = TRUE;
+          _ide_pipeline_find_programs_async (pipeline, programs, NULL,
+                                             ide_lsp_service_find_programs_cb,
+                                             g_object_ref (self));
+        }
+      IDE_EXIT;
+    }
+
