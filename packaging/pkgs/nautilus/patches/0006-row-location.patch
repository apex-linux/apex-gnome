Date: Sat, 24 Oct 2026 09:14:31 +0000
Subject: [PATCH] name-cell: show the location of a row bound before its path

The list view binds a cell's item through an expression set up with the
cell, and only then, in bind_name_cell(), tells the cell which path
attribute to show. The item's binding already updated the labels, with
no path attribute yet, and the setters did not update them again, so a
cell first bound to a search result showed no location. That happens
whenever the shown rows change under a filter, as with the Apex search
chips (src/apex/, Source1). The setters now update the labels of a bound
cell.
---
 src/nautilus-name-cell.c | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/src/nautilus-name-cell.c b/src/nautilus-name-cell.c
index 953c88e..4dddff5 100644
--- a/src/nautilus-name-cell.c
+++ b/src/nautilus-name-cell.c
@@ -492,6 +492,17 @@ nautilus_name_cell_new (NautilusListBase *view)
                                              NULL));
 }
 
+static void
+update_labels_if_bound (NautilusNameCell *self)
+{
+    g_autoptr (NautilusViewItem) item = nautilus_view_cell_get_item (NAUTILUS_VIEW_CELL (self));
+
+    if (item != NULL)
+    {
+        update_labels (self);
+    }
+}
+
 void
 nautilus_name_cell_set_path (NautilusNameCell *self,
                              GQuark            path_attribute_q,
@@ -499,6 +510,7 @@ nautilus_name_cell_set_path (NautilusNameCell *self,
 {
     self->path_attribute_q = path_attribute_q;
     g_set_object (&self->file_path_base_location, base_location);
+    update_labels_if_bound (self);
 }
 
 void
@@ -506,6 +518,7 @@ nautilus_name_cell_set_show_snippet (NautilusNameCell *self,
                                      gboolean          show)
 {
     self->show_snippet = show;
+    update_labels_if_bound (self);
 }
 
 GtkTreeExpander *
