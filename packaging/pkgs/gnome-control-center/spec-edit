# Anchored edits to Fedora's gnome-control-center.spec; format and placeholders:
# packaging/README.md. apex-lane adds the PatchNNNN lines itself.

# %{autorelease} with braces sorts the suffix above Fedora's build (see gnome-shell's).
replace ^Release:[[:space:]]+%autorelease$
	Release:	%{autorelease}@APEX_RELEASE@
end

# The Software Updates page's proxy is generated from apex-system's GPL-3.0-or-later interface.
replace ^License:[[:space:]]+GPL-2\.0-or-later AND CC0-1\.0$
	License:        GPL-2.0-or-later AND GPL-3.0-or-later AND CC0-1.0
end

after ^Source0:[[:space:]]
	Source1:	@SOURCE1@
end

after ^%autosetup[[:space:]]
	# Apex: panels/apex/ (Source1, desktop/control-center/ in apex-gnome); -k never clobbers upstream.
	tar -xkf %{SOURCE1}
end
