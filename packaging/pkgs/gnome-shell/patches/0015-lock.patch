Subject: [PATCH] lock: hooks for the Apex lock screen (unlock path)

Review label: unlock path.

Value and behaviour hooks for the single-stage lock screen of DESIGN.md,
which the Apex layer's lock feature provides (ROADMAP S3b). They change
what the lock screen shows, never whether it unlocks: unlocking stays
GDM's, through logind's Unlock signal after PAM succeeds, and a hook
that throws gives the stock value or code at its call site.

- UnlockDialog: a value hook over the background blur's brightness and
  radius; one over the clock's share of the transition progress, so the
  clock can stay shown with the prompt; one over the stack's box in
  UnlockDialogLayout, so the layer's stage keeps one layout across
  upstream's changes to it; a behaviour hook at the end of
  _init(), through which the layer lays the dialog out and shows or
  tears down the prompt as the screen wakes or blanks;
- ScreenShield: a value hook over whether the session going idle
  cancels the unlock dialog's conversation, given the dialog, so the
  layer keeps a prompt it manages until the screen blanks;
- AuthPrompt: a value hook over the question shown for a PAM question,
  given upstream's text and PAM's own;
- Avatar: a value hook over the child shown when the user has no
  picture.
---
 js/gdm/authPrompt.js  |  9 +++++----
 js/ui/screenShield.js |  4 +++-
 js/ui/unlockDialog.js | 20 ++++++++++++--------
 js/ui/userWidget.js   |  5 +++--
 4 files changed, 23 insertions(+), 15 deletions(-)

diff --git a/js/gdm/authPrompt.js b/js/gdm/authPrompt.js
index 06a8758..6e870a6 100644
--- a/js/gdm/authPrompt.js
+++ b/js/gdm/authPrompt.js
@@ -17,6 +17,7 @@ import * as UserVerifier from './userVerifier.js';
 import * as UserWidget from '../ui/userWidget.js';
 import * as WebLogin from './webLogin.js';
 import {wiggle} from '../misc/animationUtils.js';
+import * as ApexHooks from '../ui/apex/hooks.js';
 
 import {loadInterfaceXML} from '../misc/fileUtils.js';
 
@@ -529,10 +530,10 @@ export const AuthPrompt = GObject.registerClass({
         // Hack: The question string comes directly from PAM, if it's "Password:"
         // we replace it with our own to allow localization, if it's something
         // else we remove the last colon and any trailing or leading spaces.
-        if (question === 'Password:' || question === 'Password: ')
-            this.setQuestion(_('Password'));
-        else
-            this.setQuestion(question.replace(/[:：] *$/, '').trim());
+        const stockQuestion = question === 'Password:' || question === 'Password: '
+            ? _('Password')
+            : question.replace(/[:：] *$/, '').trim();
+        this.setQuestion(ApexHooks.value('auth-prompt-question', stockQuestion, question));
 
         this.emit('prompted');
     }
diff --git a/js/ui/screenShield.js b/js/ui/screenShield.js
index 5961ea1..c3178f5 100644
--- a/js/ui/screenShield.js
+++ b/js/ui/screenShield.js
@@ -20,6 +20,7 @@ import * as ShellDBus from './shellDBus.js';
 import * as SmartcardManager from '../gdm/smartcardManager.js';
 
 import {adjustAnimationTime} from '../misc/animationUtils.js';
+import * as ApexHooks from './apex/hooks.js';
 
 const SCREENSAVER_SCHEMA = 'org.gnome.desktop.screensaver';
 const LOCK_ENABLED_KEY = 'lock-enabled';
@@ -249,7 +250,8 @@ export class ScreenShield extends Signals.EventEmitter {
         if (status !== GnomeSession.PresenceStatus.IDLE)
             return;
 
-        this._maybeCancelDialog();
+        if (ApexHooks.value('unlock-idle-cancel', true, this._dialog))
+            this._maybeCancelDialog();
 
         if (this._longLightbox.visible) {
             // We're in the process of showing.
diff --git a/js/ui/unlockDialog.js b/js/ui/unlockDialog.js
index 21b4736..8c77b98 100644
--- a/js/ui/unlockDialog.js
+++ b/js/ui/unlockDialog.js
@@ -21,6 +21,7 @@ import * as AuthPrompt from '../gdm/authPrompt.js';
 import {AuthPromptStatus} from '../gdm/authPrompt.js';
 import {MprisSource} from './mpris.js';
 import {MediaMessage} from './messageList.js';
+import * as ApexHooks from './apex/hooks.js';
 
 const PRIMARY_UNLOCK_METHOD_SECTION_NAME = _('Unlock Options');
 
@@ -504,7 +505,7 @@ class UnlockDialogLayout extends Clutter.LayoutManager {
         actorBox.x2 = columnX1 + columnWidth;
         actorBox.y2 = stackY + stackHeight;
 
-        this._stack.allocate(actorBox);
+        this._stack.allocate(ApexHooks.value('unlock-stack-box', actorBox, this, box));
 
         // Auth Indicator button (bottom start)
         if (this._authIndicatorButton.visible) {
@@ -740,6 +741,7 @@ export const UnlockDialog = GObject.registerClass({
         this._idleWatchId = this._idleMonitor.add_idle_watch(IDLE_TIMEOUT * 1000, this._escape.bind(this));
 
         this.connect('destroy', this._onDestroy.bind(this));
+        ApexHooks.run('unlock-dialog', this);
     }
 
     _onKeyPress() {
@@ -802,14 +804,15 @@ export const UnlockDialog = GObject.registerClass({
 
     _updateBackgroundEffects() {
         const themeContext = St.ThemeContext.get_for_stage(global.stage);
+        const blur = ApexHooks.value('unlock-blur', {brightness: BLUR_BRIGHTNESS, radius: BLUR_RADIUS});
 
         for (const widget of this._backgroundGroup) {
             const effect = widget.get_effect('blur');
 
             if (effect) {
                 effect.set({
-                    brightness: BLUR_BRIGHTNESS,
-                    radius: BLUR_RADIUS * themeContext.scale_factor,
+                    ...blur,
+                    radius: blur.radius * themeContext.scale_factor,
                 });
             }
         }
@@ -897,3 +900,4 @@ export const UnlockDialog = GObject.registerClass({
         this._promptBox.visible = progress > 0;
-        this._clock.visible = progress < 1;
+        const clockProgress = ApexHooks.value('unlock-clock-progress', progress);
+        this._clock.visible = clockProgress < 1;
 
@@ -926,13 +930,13 @@ export const UnlockDialog = GObject.registerClass({
 
         const clockMotionParams = useMotion
             ? {
-                scale_x: FADE_OUT_SCALE + (1 - FADE_OUT_SCALE) * (1 - progress),
-                scale_y: FADE_OUT_SCALE + (1 - FADE_OUT_SCALE) * (1 - progress),
-                translation_y: -FADE_OUT_TRANSLATION * progress * scaleFactor,
+                scale_x: FADE_OUT_SCALE + (1 - FADE_OUT_SCALE) * (1 - clockProgress),
+                scale_y: FADE_OUT_SCALE + (1 - FADE_OUT_SCALE) * (1 - clockProgress),
+                translation_y: -FADE_OUT_TRANSLATION * clockProgress * scaleFactor,
             } : {};
 
         this._clock.set({
-            opacity: 255 * (1 - progress),
+            opacity: 255 * (1 - clockProgress),
             ...clockMotionParams,
         });
 
