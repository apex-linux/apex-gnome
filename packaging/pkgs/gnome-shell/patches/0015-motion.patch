Subject: [PATCH] environment: hooks for the Apex motion

Two hooks around the shell's one easing path, which the Apex layer's
motion feature provides (apex ROADMAP S3c):

- ease: a value hook over an ease's parameters in _easeActor and
  _easeAnimatableProperty, before the easing state is set, through
  which the feature gives curved modes Clutter's CUBIC_BEZIER and window
  geometry, the overview and popovers DESIGN's durations;
- eased: a behaviour hook once the transitions exist, which sets their
  cubic-bezier control points, since a mode alone takes Clutter's.

adjustAnimationTime still runs after the hook, so enable-animations=false
keeps every duration at 0 ms. Without the layer both hooks return stock.
---
 js/ui/environment.js | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/js/ui/environment.js b/js/ui/environment.js
index 074837d..781ced2 100644
--- a/js/ui/environment.js
+++ b/js/ui/environment.js
@@ -16,6 +16,7 @@ import Shell from 'gi://Shell';
 import St from 'gi://St';
 
 import * as SignalTracker from '../misc/signalTracker.js';
+import * as ApexHooks from './apex/hooks.js';
 import {adjustAnimationTime} from '../misc/animationUtils.js';
 import {logErrorUnlessCancelled} from '../misc/errorUtils.js';
 
@@ -155,7 +156,7 @@ function _easeActor(actor, params) {
         repeatCount: 0,
         autoReverse: false,
         animationRequired: false,
-        ...params,
+        ...ApexHooks.value('ease', params, actor),
     };
 
     actor.save_easing_state();
@@ -203,6 +204,7 @@ function _easeActor(actor, params) {
         .filter(t => t !== null);
 
     transitions.forEach(t => t.set({repeatCount, autoReverse}));
+    ApexHooks.run('eased', transitions);
 
     const [transition] = transitions;
 
@@ -221,7 +223,7 @@ function _easeAnimatableProperty(animatable, propName, target, params) {
         repeatCount: 0,
         autoReverse: false,
         animationRequired: false,
-        ...params,
+        ...ApexHooks.value('ease', params, animatable),
     };
 
     // Avoid pointless difference with ease()
@@ -286,6 +288,7 @@ function _easeAnimatableProperty(animatable, propName, target, params) {
         ...params,
     });
     animatable.add_transition(propName, transition);
+    ApexHooks.run('eased', [transition]);
 
     transition.set_to(target);
 
