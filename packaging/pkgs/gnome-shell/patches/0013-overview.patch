 js/ui/searchController.js   | 6 ++++++
 js/ui/windowPreview.js      | 9 +++++----
 js/ui/workspace.js          | 2 ++
 js/ui/workspaceThumbnail.js | 5 +++--
 5 files changed, 18 insertions(+), 7 deletions(-)

