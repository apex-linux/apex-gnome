# gnome-shell in the rebuild lane (ADR 0014; ARCHITECTURE 4.1). apex-lane reads it as
# KEY=VALUE lines and never sources it. The keys: packaging/README.md.

# Fedora's SRPM of this name, resolved in the image compose's repositories and verified
# against the pinned Fedora key.
source=fedora-srpm
srpm=gnome-shell

# A patch conflict, a failed build or a failed lane check holds the family: the last
# good set in rpms.lock keeps winning (ARCHITECTURE 4.3).
on_fail=hold
family=gnome-shell

# Binary packages of the built set that the image takes from [apex].
install=gnome-shell gnome-shell-common

# Built against mutter-devel at one exact EVR: spec-edit writes it into BuildRequires
# and Requires, and these Fedora-signed binaries of that mutter build go unmodified
# into the lock with the shell. mutter-devkit (gnome-shell --devkit, the dev loop) is
# stored with the build but never locked.
pin=mutter
mirror=mutter mutter-common
mirror_dev=mutter-devkit

# Source1: a git archive of desktop/shell/, unpacked at the top of the tree in %prep.
# Every member must be one of these paths (a trailing / means a directory).
source1=desktop/shell
source1_paths=apex.gresource.xml js/ui/apex/ data/theme/apex/

# What spec-edit's %prep lines do besides unpacking Source1; the lane checks that the
# tree is Fedora's plus the series, Source1 and exactly these changes. Upstream's
# compiled light and dark sheets become the safe-mode sheets; the high-contrast one goes.
prep_moved=data/theme/gnome-shell-light.css:data/theme/apex/stock/gnome-shell-light.css data/theme/gnome-shell-dark.css:data/theme/apex/stock/gnome-shell-dark.css
prep_deleted=data/theme/gnome-shell-high-contrast.css
