From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 24 Oct 2026 06:47:21 +0000
Subject: [PATCH] window: the Apex sessions sidebar in place of the tab bar

The Apex terminal (src/apex/, Source100) replaces Ptyxis's tab bar with a
sidebar of sessions, grouped by where they run, each with its status.
These hunks hook it in:

- ptyxis_window_init() ends with apex_window_attach(), which puts the
  sidebar beside the window's content and restyles the header bar; with
  APEX_PTYXIS_STOCK=1 it does nothing;
- the tab bar stays hidden while the window shows the sidebar.
---
 src/ptyxis-window.c | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/src/ptyxis-window.c b/src/ptyxis-window.c
index ac565dd..48cb70b 100644
--- a/src/ptyxis-window.c
+++ b/src/ptyxis-window.c
@@ -41,6 +41,8 @@
 #include "ptyxis-window.h"
 #include "ptyxis-window-dressing.h"
 
+#include "apex/apex-window.h"
+
 #ifdef GDK_WINDOWING_X11
 # include <gdk/x11/gdkx.h>
 #endif
@@ -395,7 +397,7 @@ update_visible_and_maybe_close (PtyxisWindow *self)
     }
 
   was_visible = gtk_widget_get_visible (GTK_WIDGET (self->tab_bar));
-  visible = !self->single_terminal_mode && n_pages > 1;
+  visible = !self->single_terminal_mode && n_pages > 1 && !apex_window_shows_sessions (self);
 
   if (visible != was_visible)
     {
@@ -2223,6 +2225,8 @@ ptyxis_window_init (PtyxisWindow *self)
                                      empty_display_name, NULL, NULL);
   gtk_custom_filter_set_filter_func (self->maybe_containers_filter,
                                      nonempty_display_name, NULL, NULL);
+
+  apex_window_attach (self);
 }
 
 PtyxisTab *
