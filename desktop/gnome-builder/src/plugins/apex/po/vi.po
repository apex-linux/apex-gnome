# Vietnamese translation of Apex Code's additions to GNOME Builder (apex-builder).
# Bản dịch tiếng Việt cho phần Apex thêm vào GNOME Builder (Apex Code).
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Glossary, following GNOME's existing Vietnamese; Builder 50 itself ships no vi catalogue:
#   Preferences = Tùy thích; project = dự án; language server = máy chủ ngôn ngữ;
#   build = biên dịch; home folder = thư mục riêng; host = máy chính; toolbox stays toolbox.
#
msgid ""
msgstr ""
"Project-Id-Version: apex-builder\n"
"Report-Msgid-Bugs-To: https://github.com/apex-linux/apex-gnome/issues\n"
"PO-Revision-Date: 2026-11-05 00:00+0000\n"
"Last-Translator: Apex <noreply@apex-linux.github.io>\n"
"Language-Team: Vietnamese <gnome-vi-list@gnome.org>\n"
"Language: vi\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=1; plural=0;\n"

#. TRANSLATORS: the product name; keep it as is unless your language writes it in another script
#: src/plugins/apex/apex-brand.h:11
msgid "Apex Code"
msgstr "Apex Code"

#. TRANSLATORS: a window title; %s is the project or page
#: src/plugins/apex/apex-brand.h:18
#, c-format
msgid "Apex Code — %s"
msgstr "Apex Code — %s"

#. TRANSLATORS: the Preferences window's title; %s is the project
#: src/plugins/apex/apex-brand.h:26
#, c-format
msgid "Apex Code — %s — Preferences"
msgstr "Apex Code — %s — Tùy thích"

#: src/plugins/apex/apex-brand.h:28
msgid "Apex Code — Preferences"
msgstr "Apex Code — Tùy thích"

#: src/plugins/apex/gbp-apex-workbench-addin.c:61
msgid "Create Toolbox"
msgstr "Tạo toolbox"

#. TRANSLATORS: %s is the project's folder
#: src/plugins/apex/gbp-apex-workbench-addin.c:99
#, c-format
msgid ""
"%s is outside the folders the toolbox shares, so its language servers cannot "
"start. Move the project into your home folder."
msgstr "%s nằm ngoài các thư mục mà toolbox chia sẻ nên các máy chủ ngôn ngữ của dự án không thể khởi chạy. Hãy chuyển dự án vào thư mục riêng của bạn."

#: src/plugins/apex/gbp-apex-workbench-addin.c:101
msgid "Project Outside the Toolbox"
msgstr "Dự án nằm ngoài toolbox"

#: src/plugins/apex/gbp-apex-workbench-addin.c:167
msgid "No Toolbox for Builds"
msgstr "Chưa có toolbox để biên dịch"

#: src/plugins/apex/gbp-apex-workbench-addin.c:168
msgid ""
"Apex Code builds and runs language servers in the fedora-toolbox-45 toolbox. "
"Until it exists, they run on the host."
msgstr "Apex Code biên dịch và chạy các máy chủ ngôn ngữ trong toolbox fedora-toolbox-45. Khi toolbox này chưa có, chúng chạy trên máy chính."

#: src/plugins/apex/gbp-apex-workbench-addin.c:210
#: src/plugins/apex/gbp-apex-workbench-addin.c:240
msgid "Could Not Create the Toolbox"
msgstr "Không thể tạo toolbox"

#: src/plugins/apex/gbp-apex-workbench-addin.c:213
msgid "Toolbox Ready"
msgstr "Toolbox đã sẵn sàng"

#: src/plugins/apex/gbp-apex-workbench-addin.c:214
msgid ""
"fedora-toolbox-45 has its language servers. Reopen the project to build and "
"run them in the toolbox."
msgstr "fedora-toolbox-45 đã có các máy chủ ngôn ngữ. Hãy mở lại dự án để biên dịch và chạy chúng trong toolbox."

#: src/plugins/apex/gbp-apex-workbench-addin.c:246
msgid "Creating the Toolbox"
msgstr "Đang tạo toolbox"

#: src/plugins/apex/gbp-apex-workbench-addin.c:247
msgid "Downloading fedora-toolbox-45 and installing its language servers."
msgstr "Đang tải fedora-toolbox-45 và cài đặt các máy chủ ngôn ngữ."
