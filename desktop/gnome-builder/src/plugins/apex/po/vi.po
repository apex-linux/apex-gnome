#. TRANSLATORS: the product name; keep it as is unless your language writes it in another script
#: src/plugins/apex/apex-brand.h:11
msgid "Apex Code"
msgstr "Apex Code"

#. TRANSLATORS: a window title; %s is the project or page
#: src/plugins/apex/apex-brand.h:18
#, c-format
msgid "Apex Code — %s"
msgstr "Apex Code — %s"

#. TRANSLATORS: the Preferences window's title; %s is the project
#: src/plugins/apex/apex-brand.h:26
#, c-format
msgid "Apex Code — %s — Preferences"
msgstr "Apex Code — %s — Tùy thích"

#: src/plugins/apex/apex-brand.h:28
msgid "Apex Code — Preferences"
msgstr "Apex Code — Tùy thích"

#: src/plugins/apex/gbp-apex-a11y-addins.c:40
msgid "Build Details"
msgstr "Chi tiết biên dịch"

#: src/plugins/apex/gbp-apex-a11y-addins.c:42
msgid "New Page"
msgstr "Trang mới"

#: src/plugins/apex/gbp-apex-a11y-addins.c:44
msgid "Sidebar Menu"
msgstr "Trình đơn thanh bên"

#: src/plugins/apex/gbp-apex-a11y-addins.c:46
msgid "Open Pages"
msgstr "Các trang đang mở"

#: src/plugins/apex/gbp-apex-a11y-addins.c:54
msgid "Run Options"
msgstr "Tùy chọn chạy"

#: src/plugins/apex/gbp-apex-a11y-addins.c:66
msgid "Run Project"
msgstr "Chạy dự án"

#. TRANSLATORS: the editor's accessible name; %s is the file
#: src/plugins/apex/gbp-apex-a11y-addins.c:162
#, c-format
msgid "Editor for %s"
msgstr "Trình soạn thảo cho %s"

#: src/plugins/apex/gbp-apex-workbench-addin.c:63
msgid "Create Toolbox"
msgstr "Tạo toolbox"

#. TRANSLATORS: %s is the project's folder
#: src/plugins/apex/gbp-apex-workbench-addin.c:126
#, c-format
msgid "%s is outside the folders the toolbox shares, so its language servers cannot start. Move the project into your home folder."
msgstr "%s nằm ngoài các thư mục mà toolbox chia sẻ nên các máy chủ ngôn ngữ của dự án không thể khởi chạy. Hãy chuyển dự án vào thư mục riêng của bạn."

#: src/plugins/apex/gbp-apex-workbench-addin.c:128
msgid "Project Outside the Toolbox"
msgstr "Dự án nằm ngoài toolbox"

#: src/plugins/apex/gbp-apex-workbench-addin.c:198
msgid "No Toolbox for Builds"
msgstr "Chưa có toolbox để biên dịch"

#: src/plugins/apex/gbp-apex-workbench-addin.c:199
msgid "Apex Code builds and runs language servers in the fedora-toolbox-45 toolbox. Until it exists, they run on the host."
msgstr "Apex Code biên dịch và chạy các máy chủ ngôn ngữ trong toolbox fedora-toolbox-45. Khi toolbox này chưa có, chúng chạy trên máy chính."

#: src/plugins/apex/gbp-apex-workbench-addin.c:241
#: src/plugins/apex/gbp-apex-workbench-addin.c:271
msgid "Could Not Create the Toolbox"
msgstr "Không thể tạo toolbox"

#: src/plugins/apex/gbp-apex-workbench-addin.c:244
msgid "Toolbox Ready"
msgstr "Toolbox đã sẵn sàng"

#: src/plugins/apex/gbp-apex-workbench-addin.c:245
msgid "fedora-toolbox-45 has its language servers. Reopen the project to build and run them in the toolbox."
msgstr "fedora-toolbox-45 đã có các máy chủ ngôn ngữ. Hãy mở lại dự án để biên dịch và chạy chúng trong toolbox."

#: src/plugins/apex/gbp-apex-workbench-addin.c:277
msgid "Creating the Toolbox"
msgstr "Đang tạo toolbox"

#: src/plugins/apex/gbp-apex-workbench-addin.c:278
msgid "Downloading fedora-toolbox-45 and installing its language servers."
msgstr "Đang tải fedora-toolbox-45 và cài đặt các máy chủ ngôn ngữ."
