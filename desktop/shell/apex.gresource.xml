<!--
  Every Apex JS module and theme asset needs its <file> line here. Paths are relative to
  the top of the gnome-shell tree, where %prep unpacks desktop/shell/.
-->
<gresources>
  <gresource prefix="/org/gnome/shell/ui/apex">
    <file alias="hooks.js">js/ui/apex/hooks.js</file>
    <file alias="layer.js">js/ui/apex/layer.js</file>
    <file alias="fault/feature.js">js/ui/apex/fault/feature.js</file>
    <file alias="witness/feature.js">js/ui/apex/witness/feature.js</file>
    <file alias="spotlight/feature.js">js/ui/apex/spotlight/feature.js</file>
  </gresource>
  <gresource prefix="/org/gnome/shell/theme/apex">
    <file alias="diamond-light.svg">data/theme/apex/diamond-light.svg</file>
    <file alias="diamond-dark.svg">data/theme/apex/diamond-dark.svg</file>
  </gresource>
  <!--
    Safe mode's sheets: upstream's compiled ones, moved here by %prep. With no stock
    high-contrast sheet, safe mode uses the rebuilt one.
  -->
  <gresource prefix="/org/gnome/shell/theme/stock">
    <file alias="gnome-shell-light.css">data/theme/apex/stock/gnome-shell-light.css</file>
    <file alias="gnome-shell-dark.css">data/theme/apex/stock/gnome-shell-dark.css</file>
  </gresource>
</gresources>
