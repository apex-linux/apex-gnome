#: js/ui/apex/dock/trash.js:32 js/ui/apex/dock/trash.js:51
msgid "Trash"
msgstr "Thùng rác"

#: js/ui/apex/dock/trash.js:54 js/ui/apex/spotlight/popup.js:278
msgid "Open"
msgstr "Mở"

#: js/ui/apex/dock/trash.js:55
