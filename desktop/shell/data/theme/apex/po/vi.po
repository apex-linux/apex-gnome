msgstr "Dùng phiên bản mới từ lần khởi động sau"

#: js/ui/apex/end-session/card.js:15
msgid ""
"The update could not be prepared. Software Updates in Settings has the "
"details."
msgstr "Không thể chuẩn bị bản cập nhật. Xem chi tiết trong Cập nhật phần mềm của Cài đặt."

#: js/ui/apex/end-session/feature.js:23
msgid "Restart & Update"
msgstr "Khởi động lại & cập nhật"

#: js/ui/apex/lock/fingerprint.js:16
msgid "Or touch the fingerprint reader"
msgstr "Hoặc chạm vào đầu đọc vân tay"

