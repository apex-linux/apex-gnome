# SPDX-License-Identifier: GPL-2.0-or-later
#
# Glossary, following GNOME's existing Vietnamese where upstream already translates the word:
#   Settings = Cài đặt; Files = Tệp; Software Updates = Cập nhật phần mềm;
#   Trash = Thùng rác; Empty Trash = Đổ rác; Do Not Disturb = Đừng làm phiền;
#   Search = Tìm kiếm; Copy = Chép; Clear = Xóa; Desktop = Màn hình nền;
#   unlock = mở khóa; restart = khởi động lại; Administrator = Quản trị viên.
#
