#
# The sassc targets depend on theme_sources, so a change to an Apex partial recompiles
# the sheets.
theme_sources += files(
  '_apex-tokens.scss',
  '_apex.scss',
  '_top-bar.scss',
  '_popup-menus.scss',
  '_osd.scss',
  '_notification-banner.scss',
  '_quick-settings.scss',
  '_switcher.scss',
  '_dialogs.scss',
  '_date-menu.scss',
  '_overview.scss',
  '_app-grid.scss',
  '_lock.scss',
  '_greeter.scss',
  '_derived.scss',
  '_dock.scss',
  '_tile-preview.scss',
  '_spotlight.scss',
  '_glass.scss',
  '_screenshot.scss',
  '_indicators.scss',
  '_apex-structure.scss',
)
