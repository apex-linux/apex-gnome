# Vietnamese translation of Apex's Settings panels (apex-control-center).
# Bản dịch tiếng Việt cho các bảng Cài đặt của Apex.
# SPDX-License-Identifier: GPL-2.0-or-later
#
# Glossary, following GNOME's existing Vietnamese where upstream already translates the word:
#   Settings = Cài đặt; Files = Tệp; Software Updates = Cập nhật phần mềm;
#   Top Bar = Thanh đỉnh; Hot Corner = Góc nóng; Preferences = Tùy thích;
#   window = cửa sổ; maximize = phóng to; overview = màn hình tổng quan;
#   restart = khởi động lại; download = tải về; build = bản dựng; version = phiên bản;
#   channel = kênh; signature = chữ ký; refresh rate = tốc độ làm tươi;
#   driver = trình điều khiển; dock = dock (kept, as in GNOME's vi); Terminal = Dòng lệnh.
#
msgid ""
msgstr ""
"Project-Id-Version: apex-control-center\n"
"Report-Msgid-Bugs-To: https://github.com/apex-linux/apex-gnome/issues\n"
"PO-Revision-Date: 2026-11-04 00:00+0000\n"
"Last-Translator: Apex <noreply@apex-linux.github.io>\n"
"Language-Team: Vietnamese <gnome-vi-list@gnome.org>\n"
"Language: vi\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=1; plural=0;\n"

#: panels/apex/cc-apex-background.c:64
#, c-format
msgid "%s has a light and a dark version and follows the style."
msgstr "%s có bản sáng và bản tối, đổi theo kiểu giao diện."

#: panels/apex/cc-apex-background.c:65
#, c-format
msgid "%s is one picture for both styles."
msgstr "%s là một ảnh dùng cho cả hai kiểu giao diện."

#: panels/apex/cc-apex-header.c:33
#, c-format
msgid "Version %s"
msgstr "Phiên bản %s"

#: panels/apex/cc-apex-header.c:37
#, c-format
msgid "GNOME Shell %s on Wayland"
msgstr "GNOME Shell %s trên Wayland"

#: panels/apex/cc-apex-header.c:39
#, c-format
msgid "GNOME Shell %s on X11"
msgstr "GNOME Shell %s trên X11"

#: panels/apex/cc-apex-header.c:41
#, c-format
msgid "GNOME Shell %s"
msgstr "GNOME Shell %s"

#: panels/apex/cc-apex-header.c:174 panels/apex/gnome-apex-panel.desktop.in:3
msgid "Apex Desktop"
msgstr "Màn hình nền Apex"

#: panels/apex/cc-apex-panel.blp:33
msgid "Top Bar"
msgstr "Thanh đỉnh"

#: panels/apex/cc-apex-panel.blp:36
msgid "Translucent Top Bar"
msgstr "Thanh đỉnh trong mờ"

#: panels/apex/cc-apex-panel.blp:37
msgid "Turns solid when a window is maximized"
msgstr "Chuyển sang màu đặc khi có cửa sổ được phóng to"

#: panels/apex/cc-apex-panel.blp:41
msgid "Show Focused App Name"
msgstr "Hiển thị tên ứng dụng đang dùng"

#: panels/apex/cc-apex-panel.blp:45
msgid "Show Date in Clock"
msgstr "Hiển thị ngày trên đồng hồ"

#: panels/apex/cc-apex-panel.blp:49
msgid "Show Battery Percentage"
msgstr "Hiển thị phần trăm pin"

#: panels/apex/cc-apex-panel.blp:53
msgid "Hot Corner"
msgstr "Góc nóng"

#: panels/apex/cc-apex-panel.blp:54
msgid "Touch the top-left corner to open the overview"
msgstr "Chạm vào góc trên bên trái để mở màn hình tổng quan"

#: panels/apex/cc-apex-panel.blp:59
msgid "Dock"
msgstr "Dock"

#: panels/apex/cc-apex-panel.blp:62
msgid "Icon Size"
msgstr "Cỡ biểu tượng"

#: panels/apex/cc-apex-panel.blp:71
msgctxt "dock icon size"
msgid "S"
msgstr "N"

#: panels/apex/cc-apex-panel.blp:72
msgid "Small"
msgstr "Nhỏ"

#: panels/apex/cc-apex-panel.blp:77
msgctxt "dock icon size"
msgid "M"
msgstr "V"

#: panels/apex/cc-apex-panel.blp:78
msgid "Medium"
msgstr "Vừa"

#: panels/apex/cc-apex-panel.blp:83
msgctxt "dock icon size"
msgid "L"
msgstr "L"

#: panels/apex/cc-apex-panel.blp:84
msgid "Large"
msgstr "Lớn"

#: panels/apex/cc-apex-panel.blp:90
msgid "Hide Behind Maximized Windows"
msgstr "Ẩn sau cửa sổ được phóng to"

#: panels/apex/cc-apex-panel.blp:91
msgid "Move the pointer to the bottom edge to reveal it"
msgstr "Đưa con trỏ xuống cạnh dưới để hiện lại"

#: panels/apex/cc-apex-panel.blp:95
msgid "Show Running Indicators"
msgstr "Hiển thị dấu ứng dụng đang chạy"

#: panels/apex/cc-apex-panel.blp:99
msgid "Show Trash"
msgstr "Hiển thị Thùng rác"

#: panels/apex/cc-apex-panel.blp:104
msgid "Windows"
msgstr "Cửa sổ"

#: panels/apex/cc-apex-panel.blp:107
msgid "Corner Radius"
msgstr "Bán kính góc bo"

#: panels/apex/cc-apex-panel.blp:108
msgid "Maximized windows are always square"
msgstr "Cửa sổ được phóng to luôn có góc vuông"

#: panels/apex/cc-apex-panel.blp:138
msgid "Titlebar Buttons"
msgstr "Nút trên thanh tiêu đề"

#: panels/apex/cc-apex-panel.blp:146
msgid "All"
msgstr "Tất cả"

#: panels/apex/cc-apex-panel.blp:151
msgid "Close only"
msgstr "Chỉ nút đóng"

#: panels/apex/cc-apex-panel.blp:157
msgid "Drag to Top Edge to Maximize"
msgstr "Kéo lên cạnh trên để phóng to"

#: panels/apex/cc-apex-panel.blp:162
msgid "Effects"
msgstr "Hiệu ứng"

#: panels/apex/cc-apex-panel.blp:165
msgid "Reduce Transparency"
msgstr "Giảm độ trong suốt"

#: panels/apex/cc-apex-panel.blp:166
msgid "Replace glass surfaces with solid colors"
msgstr "Thay bề mặt kính mờ bằng màu đặc"

#: panels/apex/cc-apex-panel.blp:170
msgid "Reduce Motion"
msgstr "Giảm chuyển động"

#: panels/apex/cc-apex-panel.blp:171
msgid "Disable window and dock animations"
msgstr "Tắt hiệu ứng chuyển động của cửa sổ và dock"

#: panels/apex/cc-apex-panel.blp:184
msgid "Apex Desktop Settings Are Missing"
msgstr "Thiếu các thiết lập của Màn hình nền Apex"

#: panels/apex/cc-apex-panel.blp:185
msgid ""
"The settings schema io.github.apex_linux.Apex.Desktop is not installed, so "
"this panel cannot change the top bar, the dock or the window corners. It "
"ships in the apex-desktop package."
msgstr "Lược đồ thiết lập io.github.apex_linux.Apex.Desktop chưa được cài đặt, nên bảng này không thể thay đổi thanh đỉnh, dock hay góc cửa sổ. Lược đồ này có trong gói apex-desktop."

#: panels/apex/cc-apex-power-state.c:30
msgctxt "graphics card"
msgid "Off"
msgstr "Tắt"

#: panels/apex/cc-apex-power-state.c:32
msgctxt "graphics card"
msgid "Waking"
msgstr "Đang bật nguồn"

#: panels/apex/cc-apex-power-state.c:34
msgctxt "graphics card"
msgid "Powering Down"
msgstr "Đang tắt nguồn"

#: panels/apex/cc-apex-power-state.c:38
msgctxt "graphics card"
msgid "On"
msgstr "Bật"

#: panels/apex/cc-apex-power-state.c:48
msgid "Powered down until an app asks for it"
msgstr "Tắt nguồn cho đến khi có ứng dụng cần dùng"

#: panels/apex/cc-apex-power-state.c:51
msgid "Powered up for an app"
msgstr "Đang bật nguồn cho một ứng dụng"

#: panels/apex/cc-apex-power-state.c:54
msgid "Its driver keeps it powered"
msgstr "Trình điều khiển giữ cho nó luôn bật nguồn"

#: panels/apex/cc-apex-power-state.c:69
msgid "NVIDIA Graphics"
msgstr "Đồ họa NVIDIA"

#: panels/apex/cc-apex-power-state.c:134
msgid ""
"The built-in display's lowest rate on battery, its highest when plugged in"
msgstr "Tốc độ làm tươi thấp nhất của màn hình tích hợp khi dùng pin, cao nhất khi cắm sạc"

#: panels/apex/cc-apex-power-state.c:136
#, c-format
msgid "The built-in display runs at %d Hz either way"
msgstr "Màn hình tích hợp luôn chạy ở %d Hz"

#: panels/apex/cc-apex-power-state.c:137
#, c-format
msgid "%d Hz on battery, %d Hz when plugged in"
msgstr "%d Hz khi dùng pin, %d Hz khi cắm sạc"

#: panels/apex/cc-apex-power.c:189
msgid "Lower Refresh Rate on Battery"
msgstr "Giảm tốc độ làm tươi khi dùng pin"

#: panels/apex/cc-apex-power.c:207
msgid "Graphics and Display"
msgstr "Đồ họa và màn hình"

#: panels/apex/cc-apex-updates-page.blp:8
msgid "Software Updates"
msgstr "Cập nhật phần mềm"

#: panels/apex/cc-apex-updates-page.blp:137
msgid "What’s New"
msgstr "Có gì mới"

#: panels/apex/cc-apex-updates-page.blp:149
msgid "Versions"
msgstr "Phiên bản"

#: panels/apex/cc-apex-updates-page.blp:152
#: panels/apex/cc-apex-updates-page.c:439
msgid "Running"
msgstr "Đang chạy"

#: panels/apex/cc-apex-updates-page.blp:163
msgid "Next Restart"
msgstr "Lần khởi động lại tới"

#: panels/apex/cc-apex-updates-page.blp:167
msgid "Checked"
msgstr "Đã kiểm tra"

#: panels/apex/cc-apex-updates-page.blp:177
#: panels/apex/cc-apex-updates-page.c:445
msgid "Previous"
msgstr "Bản trước"

#: panels/apex/cc-apex-updates-page.blp:181
msgid "Use at Next Restart…"
msgstr "Dùng ở lần khởi động lại tới…"

#: panels/apex/cc-apex-updates-page.blp:189
msgid ""
"If a new version keeps failing to start, Apex goes back to the previous one "
"by itself."
msgstr "Nếu một phiên bản mới liên tục khởi động không thành công, Apex sẽ tự quay về phiên bản trước."

#: panels/apex/cc-apex-updates-page.blp:203
msgid "Preferences"
msgstr "Tùy thích"

#: panels/apex/cc-apex-updates-page.blp:206
msgid "Automatic Downloads"
msgstr "Tự động tải về"

#: panels/apex/cc-apex-updates-page.blp:207
msgid "Waits for mains power and an unmetered network"
msgstr "Chờ có nguồn điện và mạng không giới hạn dung lượng"

#: panels/apex/cc-apex-updates-page.blp:212
msgid "Update Channel"
msgstr "Kênh cập nhật"

#: panels/apex/cc-apex-updates-page.blp:216
msgid "Last Checked"
msgstr "Kiểm tra lần cuối"

#: panels/apex/cc-apex-updates-page.blp:220
#: panels/apex/cc-apex-updates-state.c:158
msgid "Check Now"
msgstr "Kiểm tra ngay"

#: panels/apex/cc-apex-updates-page.blp:236
msgid "Software Updates Are Unavailable"
msgstr "Không thể dùng Cập nhật phần mềm"

#: panels/apex/cc-apex-updates-page.blp:237
msgid ""
"apex-updated, the Apex update service, is not installed or does not answer, "
"so this page cannot show or change the system’s updates."
msgstr "apex-updated, dịch vụ cập nhật của Apex, chưa được cài đặt hoặc không phản hồi, nên trang này không thể hiển thị hay thay đổi các bản cập nhật của hệ thống."

#: panels/apex/cc-apex-updates-page.c:365
msgid "No package changes are known."
msgstr "Chưa có thông tin về thay đổi gói."

#: panels/apex/cc-apex-updates-page.c:373
msgid "Changes in the Set-Aside Version"
msgstr "Thay đổi trong phiên bản được để riêng"

#: panels/apex/cc-apex-updates-page.c:437
msgid "Failed check"
msgstr "Không qua kiểm tra"

#: panels/apex/cc-apex-updates-page.c:441
#: panels/apex/cc-apex-updates-state.c:110
msgid "Update Failed Its Startup Check"
msgstr "Bản cập nhật không qua kiểm tra khi khởi động"

#: panels/apex/cc-apex-updates-page.c:442
msgid ""
"This version is running, but a required check did not pass. Going back to "
"the version you had before is the safe choice. Nothing restarts until you "
"say so."
msgstr "Phiên bản này đang chạy nhưng một bước kiểm tra bắt buộc không đạt. Quay về phiên bản bạn dùng trước đó là lựa chọn an toàn. Máy sẽ không khởi động lại cho đến khi bạn đồng ý."

#: panels/apex/cc-apex-updates-page.c:446
#: panels/apex/cc-apex-updates-state.c:169
msgid "Keep This Version"
msgstr "Giữ phiên bản này"

#: panels/apex/cc-apex-updates-page.c:447
#: panels/apex/cc-apex-updates-state.c:167
msgid "Go Back…"
msgstr "Quay về…"

#: panels/apex/cc-apex-updates-page.c:452
#: panels/apex/cc-apex-updates-state.c:44
msgid "Apex Went Back to the Previous Version"
msgstr "Apex đã quay về phiên bản trước"

#: panels/apex/cc-apex-updates-page.c:453
#: panels/apex/cc-apex-updates-state.c:45
msgid ""
"The update did not start properly three times in a row, so Apex started the "
"version you had before. That build will not be offered again; a newer one "
"will be."
msgstr "Bản cập nhật khởi động không thành công ba lần liên tiếp, nên Apex đã khởi động phiên bản bạn dùng trước đó. Bản dựng đó sẽ không được đề xuất lại; bản mới hơn sẽ được đề xuất."

#: panels/apex/cc-apex-updates-page.c:457
msgid "Set aside"
msgstr "Được để riêng"

#: panels/apex/cc-apex-updates-page.c:458
msgid "Your files"
msgstr "Tệp của bạn"

#: panels/apex/cc-apex-updates-page.c:458
msgid "unchanged"
msgstr "không thay đổi"

#: panels/apex/cc-apex-updates-page.c:460
msgid "Show Changes"
msgstr "Xem thay đổi"

#: panels/apex/cc-apex-updates-page.c:461
#: panels/apex/cc-apex-updates-state.c:173
msgid "OK"
msgstr "OK"

#: panels/apex/cc-apex-updates-page.c:562
#, c-format
msgid "%s runs Fedora’s own build"
msgstr "%s chạy bản dựng của chính Fedora"

#: panels/apex/cc-apex-updates-page.c:563
msgid "This version ships it without Apex’s changes."
msgstr "Phiên bản này đi kèm nó mà không có thay đổi của Apex."

#: panels/apex/cc-apex-updates-page.c:566
#, c-format
msgid "%s runs without Apex’s changes"
msgstr "%s chạy mà không có thay đổi của Apex"

#: panels/apex/cc-apex-updates-page.c:567
#, c-format
msgid "This version ships Fedora’s own %s."
msgstr "Phiên bản này đi kèm %s của chính Fedora."

#: panels/apex/cc-apex-updates-page.c:607
msgid "Package changes"
msgstr "Thay đổi gói"

#: panels/apex/cc-apex-updates-page.c:653
#, c-format
msgid ""
"%s\n"
"Kept by Apex: %s"
msgstr "%s\nApex giữ lại: %s"

#: panels/apex/cc-apex-updates-page.c:675
msgid "Kept"
msgstr "Giữ lại"

#: panels/apex/cc-apex-updates-page.c:766
msgid "Testing: candidate builds signed with the CI key"
msgstr "Thử nghiệm: bản dựng ứng viên được ký bằng khóa CI"

#: panels/apex/cc-apex-updates-page.c:767
msgid "Stable: qualified builds signed with the release key"
msgstr "Ổn định: bản dựng đã kiểm định, được ký bằng khóa phát hành"

#: panels/apex/cc-apex-updates-page.c:769
msgid "Never"
msgstr "Không bao giờ"

#: panels/apex/cc-apex-updates-state.c:31
msgid "The new version"
msgstr "Phiên bản mới"

#: panels/apex/cc-apex-updates-state.c:52
msgid "Apex Is Up to Date"
msgstr "Apex đã là phiên bản mới nhất"

#: panels/apex/cc-apex-updates-state.c:54
#, c-format
msgid "%s is the newest build on the %s channel. Checked %s."
msgstr "%s là bản dựng mới nhất trên kênh %s. Đã kiểm tra %s."

#: panels/apex/cc-apex-updates-state.c:58
#, c-format
msgid "%s is the newest build on the %s channel."
msgstr "%s là bản dựng mới nhất trên kênh %s."

#: panels/apex/cc-apex-updates-state.c:63
msgid "Update Waiting"
msgstr "Bản cập nhật đang chờ"

#: panels/apex/cc-apex-updates-state.c:64
#, c-format
msgid "%s %s waits until then."
msgstr "%s %s sẽ chờ đến lúc đó."

#: panels/apex/cc-apex-updates-state.c:72
msgid "Update Available"
msgstr "Có bản cập nhật"

#: panels/apex/cc-apex-updates-state.c:73
#, c-format
msgid ""
"%s. It downloads in the background and nothing changes until you restart."
msgstr "%s. Bản này tải về ở chế độ nền và không có gì thay đổi cho đến khi bạn khởi động lại."

#: panels/apex/cc-apex-updates-state.c:78
msgid "Downloading Update"
msgstr "Đang tải bản cập nhật"

#: panels/apex/cc-apex-updates-state.c:79
#, c-format
msgid "%s. You can keep working; Apex checks the signature before keeping it."
msgstr "%s. Bạn có thể tiếp tục làm việc; Apex sẽ kiểm tra chữ ký trước khi giữ lại bản này."

#: panels/apex/cc-apex-updates-state.c:83
msgid "Update Not Offered"
msgstr "Không có bản cập nhật được đề xuất"

#: panels/apex/cc-apex-updates-state.c:88
msgid "Update Downloaded"
msgstr "Đã tải bản cập nhật"

#: panels/apex/cc-apex-updates-state.c:89
#, c-format
msgid "%s waits until you restart into it. Your current version keeps running."
msgstr "%s sẽ chờ cho đến khi bạn khởi động lại vào nó. Phiên bản hiện tại vẫn tiếp tục chạy."

#: panels/apex/cc-apex-updates-state.c:93
#: panels/apex/cc-apex-updates-state.c:100
msgid "Restart to Finish Updating"
msgstr "Khởi động lại để hoàn tất cập nhật"

#: panels/apex/cc-apex-updates-state.c:94
#, c-format
msgid ""
"%s is downloaded and its signature checked. Your current version stays in "
"place until you restart."
msgstr "%s đã được tải về và kiểm tra chữ ký. Phiên bản hiện tại vẫn được giữ cho đến khi bạn khởi động lại."

#: panels/apex/cc-apex-updates-state.c:101
#: panels/apex/cc-apex-updates-state.c:105
#, c-format
msgid "%s starts the next time you restart."
msgstr "%s sẽ chạy ở lần khởi động lại tới."

#: panels/apex/cc-apex-updates-state.c:104
msgid "The Previous Version Starts Next"
msgstr "Phiên bản trước sẽ chạy ở lần tới"

#: panels/apex/cc-apex-updates-state.c:107
msgid "The previous version"
msgstr "Phiên bản trước"

#: panels/apex/cc-apex-updates-state.c:111
#, c-format
msgid ""
"%s is running, but a required check did not pass. Going back to the version "
"you had before is the safe choice. Nothing restarts until you say so."
msgstr "%s đang chạy nhưng một bước kiểm tra bắt buộc không đạt. Quay về phiên bản bạn dùng trước đó là lựa chọn an toàn. Máy sẽ không khởi động lại cho đến khi bạn đồng ý."

#: panels/apex/cc-apex-updates-state.c:119
#: panels/apex/cc-apex-updates-state.c:124
msgid "Updates Paused"
msgstr "Đã tạm dừng cập nhật"

#: panels/apex/cc-apex-updates-state.c:120
msgid ""
"System files are writable for development. Updates resume after the next "
"restart."
msgstr "Tệp hệ thống đang ở chế độ ghi được để phát triển. Việc cập nhật sẽ tiếp tục sau lần khởi động lại tới."

#: panels/apex/cc-apex-updates-state.c:126
msgid "This system is not set up to follow Apex updates."
msgstr "Hệ thống này chưa được thiết lập để nhận bản cập nhật của Apex."

#: panels/apex/cc-apex-updates-state.c:129
msgid "The Update Did Not Finish"
msgstr "Bản cập nhật chưa hoàn tất"

#: panels/apex/cc-apex-updates-state.c:131
msgid ""
"The update could not be applied at restart. Your current version is still in "
"place."
msgstr "Không thể áp dụng bản cập nhật khi khởi động lại. Phiên bản hiện tại vẫn được giữ nguyên."

