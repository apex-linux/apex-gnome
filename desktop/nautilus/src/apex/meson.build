libnautilus_sources += files(
  'apex.c',
  'apex-count-bar.c',
  'apex-details-pane.c',
  'apex-disk-footer.c',
  'apex-format.c',
  'apex-recent-strip.c',
  'apex-search-chips.c',
  'apex-settings.c',
  'apex-slot-watch.c',
  'apex-view-controls.c',
  'apex-window.c',
)

libnautilus_sources += gnome.compile_resources('apex-resources',
  'apex.gresource.xml',
  c_name: 'apex',
  extra_args: '--manual-register',
)
